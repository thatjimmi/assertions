<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- CA1707: underscores in test method names are the convention here.
         CA1515: xunit needs public test classes; this is not a library.
         CA1861: constant arrays in test data are fine. -->
    <NoWarn>$(NoWarn);CA1707;CA1515;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Assertions.cs" Link="Assertions.cs" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FsCheck.Xunit" />
  </ItemGroup>
</Project>
